// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: global_catalog
// Document ID: {gameId}
// Fields:
//   - gameId: string (required)
//   - status: string (required, enum: compatible, unstable, broken, untested)
//   - lastVerifiedAt: timestamp (required)
//   - romUrl: string (optional)
//   - emulatorCore: string (optional)
//   - successCount: number (optional)
//   - failureCount: number (optional)
//
// Collection: telemetry
// Document ID: {reportId}
// Fields:
//   - userId: string (required)
//   - timestamp: timestamp (required)
//   - type: string (required, enum: error, performance, navigation, rom_fetch, emulator)
//   - details: map (optional)
//
// Collection: config
// Document ID: global
// Fields:
//   - masterArchiveId: string (optional)
//   - maintenanceMode: bool (optional)
//
// ===============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email == "jg.hardcore.builds@gmail.com" && request.auth.token.email_verified == true);
    }

    function isValidStatus(status) {
      return status in ['compatible', 'unstable', 'broken', 'untested'];
    }

    function isValidTelemetryType(type) {
      return type in ['error', 'performance', 'navigation', 'rom_fetch', 'emulator'];
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // Global Catalog: Read for all, Write for Admin
    match /global_catalog/{gameId} {
      allow read: if true; // Publicly readable for the ecosystem
      allow write: if isAdmin();
    }

    // Telemetry: Create for authenticated users, Read for Admin
    match /telemetry/{reportId} {
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid &&
        isValidTelemetryType(request.resource.data.type);
      allow read: if isAdmin();
      allow update, delete: if false; // Telemetry is immutable
    }

    // Global Config: Read for all, Write for Admin
    match /config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
